{
  "name": "playwright-vanilla99",
  "version": "1.0.0",
  "description": "Bu proje, **Playwright**, **TypeScript** ve **Cucumber** framework'leri kullanılarak hazırlanan bir test otomasyon projesidir. Projeyi bilgisayarınıza kopyalayıp testleri sorunsuz bir şekilde koşturabilmek için aşağıdaki adımları sırasıyla takip etmeniz gerekmektedir.",
  "scripts": {
    "build": "tsc",
    "test": "playwright test",
    "test:cucumber": "cucumber-js",
    "allure:generate": "allure generate ./target/allure-results -o ./target/allure-report --clean",
    "allure:open": "allure open ./target/allure-report",
    "allure:clean": "rimraf ./target/allure-results ./target/allure-report",
    "runner:all": "cucumber-js \"src/tests/features/**/*.feature\"",
    "runner:smoke": "cucumber-js --profile smoke",
    "runner:regression": "cucumber-js --profile regression",
    "runner:testrunner": "ts-node src/tests/Runners/TestRunner.ts",
    "runner:student": "ts-node src/tests/Runners/StudentRunner.ts",
    "runner:admin": "ts-node src/tests/Runners/AdminRunner.ts",
    "runner:history": "ts-node src/tests/Runners/HistoryRunner.ts",
    "runner:visitor": "ts-node src/tests/Runners/VisitorRunner.ts",
    "test:report": "npm run test && npm run allure:generate && npm run allure:open",
    "report:clean": "rimraf ./target",
    "scripts:tree": "npx tree-node-cli -I \\\"node_modules|dist|.git|playwright-report|test-results\\\" -o proje-yapisi.txt\""


  },
  "student": {
    "paths": [
      "src/tests/features/Student/US001StLoginTest.feature"
    ],
    "require": [
      "dotenv/config",
      "src/tests/step-definitions/**/*.ts"
    ],
    "requireModule": [
      "tsconfig-paths/register",
      "ts-node/register"
    ]
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazKorsan/playwright-vanilla99.git"
  },
  "bugs": {
    "url": "https://github.com/lazKorsan/playwright-vanilla99/issues"
  },
  "homepage": "https://github.com/lazKorsan/playwright-vanilla99#readme",
  "main": "index.js"
}
